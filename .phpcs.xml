<?xml version="1.0"?>
<ruleset name="LaravelApp">
    <description>PSR-12 Coding Standard for Laravel</description>

    <!-- Ikuti PSR-12 -->
    <rule ref="PSR12"/>

    <!-- Folder Laravel yang akan diperiksa -->
    <file>app</file>
    <file>routes</file>
    <file>config</file>
    <file>database</file>

    <!-- Folder yang diabaikan -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>storage/*</exclude-pattern>
    <exclude-pattern>bootstrap/*</exclude-pattern>
</ruleset>
